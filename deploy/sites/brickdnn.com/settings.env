# Settings of brickdnn.com, read by the backend and the cleanup service (deploy/sites/README.md).
# Values set in the server's .env take precedence. Keep the periods in legal/privacy.md and
# legal/terms.md in line with these.
#
# Data sources, datasets and finished training runs nobody has used for 180 days are deleted.
BRICKDNN_DELETE_UNUSED_UPLOADS_DAYS=180
# Accounts nobody has logged in to or used for two years are deleted with everything they own.
BRICKDNN_DELETE_INACTIVE_ACCOUNTS_DAYS=730
