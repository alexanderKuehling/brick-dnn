# Settings of brickdnn.com, read by the backend, the training worker and the cleanup service
# (deploy/sites/README.md). Values set in the server's .env take precedence. Keep the periods in
# legal/privacy.md and legal/terms.md in line with these.
#
# Data sources, datasets and finished training runs nobody has used for 180 days are deleted.
BRICKDNN_DELETE_UNUSED_UPLOADS_DAYS=180
# Accounts nobody has logged in to or used for two years are deleted with everything they own.
BRICKDNN_DELETE_INACTIVE_ACCOUNTS_DAYS=730
# The owner's account is an administrator: Django admin (/admin/) and no limits. Nobody else
# can register this name.
BRICKDNN_ADMIN_USERS=alexklg
# The activity log of AI agents (page "Agent activity") is kept for 90 days.
BRICKDNN_AGENT_LOG_DAYS=90
#
# Plans (docs/training.md, "Usage and budgets"): per month the CPU hours of trainings and
# predictions, the storage for uploads, datasets and trained weights, the most CPU minutes one
# training may use, trainings at a time and the priority in the training queue (trainings of a
# plan with a higher priority start first; "queued_trainings" would set how many trainings of
# an account may wait, 3 without it). Prices are EUR per month incl.
# VAT; they are shown, and charged by Paddle once paid plans are switched on below. Paid plans
# offer compute beyond the allowance at 0.40 EUR per CPU hour, which each account has to switch
# on itself. Accounts without a plan get the default plan; staff accounts and the ones marked
# unlimited (`manage.py set_plan`) have none.
BRICKDNN_PLANS={"free": {"name": "Free", "price": 0, "cpu_hours_per_month": 0.5, "storage_gb": 1, "cpu_minutes_per_run": 15, "concurrent_trainings": 1, "priority": 0}, "starter": {"name": "Starter", "price": 5, "cpu_hours_per_month": 10, "storage_gb": 5, "cpu_minutes_per_run": 60, "concurrent_trainings": 1, "priority": 1, "overage_price_per_cpu_hour": 0.4}, "plus": {"name": "Plus", "price": 14, "cpu_hours_per_month": 30, "storage_gb": 20, "cpu_minutes_per_run": 180, "concurrent_trainings": 1, "priority": 2, "overage_price_per_cpu_hour": 0.4}, "pro": {"name": "Pro", "price": 45, "cpu_hours_per_month": 120, "storage_gb": 100, "cpu_minutes_per_run": 480, "concurrent_trainings": 2, "priority": 3, "overage_price_per_cpu_hour": 0.4}}
BRICKDNN_DEFAULT_PLAN=free
BRICKDNN_PRICE_CURRENCY=EUR
#
# Paid plans with Paddle (docs/billing.md). Off until the lines below are filled in AND the two
# secrets are in the server's .env (BRICKDNN_PADDLE_API_KEY, BRICKDNN_PADDLE_WEBHOOK_SECRET:
# never here, this file is public). Start with sandbox and Paddle's test cards, then live.
# BRICKDNN_PADDLE_ENV=sandbox
# The client-side token of Paddle.js (test_… in the sandbox, live_… live); it is public.
# BRICKDNN_PADDLE_CLIENT_TOKEN=
# The Paddle price (pri_…) of each paid plan: monthly, EUR, tax included.
# BRICKDNN_PADDLE_PRICES=starter=pri_…,plus=pri_…,pro=pri_…
# The Paddle product (pro_…) that compute beyond the allowance is billed as.
# BRICKDNN_PADDLE_OVERAGE_PRODUCT=
#
# The public address: links in e-mails (the cleanup service has no request to take it from),
# the OAuth issuer and the pricing link.
BRICKDNN_PUBLIC_URL=https://brickdnn.com
#
# E-mail (docs/email.md): password reset, confirming addresses, security notices, warnings
# before inactive accounts are deleted, server errors for the owner. Off until the provider's
# SMTP server is set below AND the login and password are in the server's .env
# (BRICKDNN_EMAIL_USER, BRICKDNN_EMAIL_PASSWORD; also BRICKDNN_ADMIN_EMAIL, the owner's address
# for server errors). Never put those here: this file is public. The domain needs the DKIM,
# SPF and DMARC records the provider shows. Then check with `manage.py send_test_email`.
# BRICKDNN_EMAIL_HOST=smtp-relay.brevo.com
# BRICKDNN_EMAIL_PORT=587
# BRICKDNN_EMAIL_FROM=Brick DNN <no-reply@brickdnn.com>
# BRICKDNN_EMAIL_REPLY_TO=
# Inactive accounts are warned this many days before they are deleted (needs e-mail).
# BRICKDNN_INACTIVE_ACCOUNT_WARNING_DAYS=14,3
#
# Two-factor authentication for the Django admin (docs/email.md): once the owner's account has
# it turned on (Account → Two-factor authentication), staff accounts without it are kept out
# of /admin/.
# BRICKDNN_REQUIRE_2FA_FOR_STAFF=true
