# Settings of brickdnn.com, read by the backend and the cleanup service (deploy/sites/README.md).
# Values set in the server's .env take precedence. Keep the periods in legal/privacy.md and
# legal/terms.md in line with these.
#
# Data sources, datasets and finished training runs nobody has used for 180 days are deleted.
BRICKDNN_DELETE_UNUSED_UPLOADS_DAYS=180
# Accounts nobody has logged in to or used for two years are deleted with everything they own.
BRICKDNN_DELETE_INACTIVE_ACCOUNTS_DAYS=730
#
# Plans (docs/training.md, "Usage and budgets"): per month the CPU hours of trainings and
# predictions, the storage for uploads, datasets and trained weights, the most CPU minutes one
# training may use, trainings at a time and the queue priority. Prices are EUR per month incl.
# VAT and only shown (no payment yet). Paid plans offer compute beyond the allowance at 0.40
# EUR per CPU hour, which each account has to switch on itself. Accounts without a plan get the
# default plan; staff accounts and the ones marked unlimited (`manage.py set_plan`) have none.
BRICKDNN_PLANS={"free": {"name": "Free", "price": 0, "cpu_hours_per_month": 0.5, "storage_gb": 1, "cpu_minutes_per_run": 15, "concurrent_trainings": 1, "priority": 0}, "starter": {"name": "Starter", "price": 5, "cpu_hours_per_month": 10, "storage_gb": 5, "cpu_minutes_per_run": 60, "concurrent_trainings": 1, "priority": 1, "overage_price_per_cpu_hour": 0.4}, "plus": {"name": "Plus", "price": 14, "cpu_hours_per_month": 30, "storage_gb": 20, "cpu_minutes_per_run": 180, "concurrent_trainings": 1, "priority": 2, "overage_price_per_cpu_hour": 0.4}, "pro": {"name": "Pro", "price": 45, "cpu_hours_per_month": 120, "storage_gb": 100, "cpu_minutes_per_run": 480, "concurrent_trainings": 2, "priority": 3, "overage_price_per_cpu_hour": 0.4}}
BRICKDNN_DEFAULT_PLAN=free
BRICKDNN_PRICE_CURRENCY=EUR
