msgstr "Das erste Vorkommen"

#: catalog
msgid "The last occurrence"
msgstr "Das letzte Vorkommen"

#: catalog
msgid "Filter rows"
msgstr "Zeilen filtern"

#: catalog
msgid "Keep only the rows that meet a condition."
msgstr "Behält nur die Zeilen, die eine Bedingung erfüllen."

#: catalog
msgid "Keep rows where the value"
msgstr "Zeilen behalten, deren Wert"

#: catalog
msgid "Rows with a missing value only pass “is missing”."
msgstr "Zeilen mit fehlendem Wert erfüllen nur „fehlt“."

#: catalog
