#: brick_dnn_core/accounts.py:645
msgid "The current password is wrong."
msgstr "Das aktuelle Passwort ist falsch."

#: brick_dnn_core/accounts.py:738
msgid "Your plan has no compute beyond its monthly allowance."
msgstr ""
"Ihr Tarif enthält keine Rechenzeit über das monatliche Kontingent hinaus."

#: brick_dnn_core/accounts.py:742
msgid ""
"Compute beyond the allowance needs a subscription that is paid and not cancelled."
msgstr ""
"Rechenzeit über das Kontingent hinaus erfordert ein bezahltes, nicht gekündigtes Abonnement."

#: brick_dnn_core/accounts.py:785
msgid "The password is wrong."
msgstr "Das Passwort ist falsch."

#: brick_dnn_core/accounts.py:790
msgid "Type your username exactly to confirm."
msgstr "Geben Sie zur Bestätigung Ihren Benutzernamen genau so ein."

#: brick_dnn_core/experiments.py:837
msgid "Shared comparison"
msgstr "Geteilter Vergleich"

#: brick_dnn_core/experiments.py:502
msgid "'order' must be asc or desc."
msgstr "„order“ muss asc oder desc sein."

#: brick_dnn_core/experiments.py:530
msgid "Give the runs as a list of run ids."
msgstr "Geben Sie die Läufe als Liste von Lauf-IDs an."

#: brick_dnn_core/experiments.py:638
msgid "'tags' must be a list of words."
msgstr "„tags“ muss eine Liste von Wörtern sein."

#: brick_dnn_core/experiments.py:661
msgid "Send tags, note or starred."
msgstr "Senden Sie tags, note oder starred."

#: brick_dnn_core/experiments.py:713
msgid "Send the columns as a list."
msgstr "Senden Sie die Spalten als Liste."

#: brick_dnn_core/experiments.py:779
msgid "'options' must be an object."
msgstr "„options“ muss ein Objekt sein."

#: brick_dnn_core/experiments.py:817
msgid "Send the runs to share."
msgstr "Senden Sie die Läufe, die Sie teilen möchten."

#: brick_dnn_core/experiments.py:820
msgid "Choose at least one run to share."
msgstr "Wählen Sie mindestens einen Lauf zum Teilen."

#: brick_dnn_core/experiments.py:836
msgid "'name' must be text."
msgstr "„name“ muss Text sein."

#: brick_dnn_core/experiments.py:840
msgid "'include_notes' must be true or false."
msgstr "„include_notes“ muss true oder false sein."

#: brick_dnn_core/experiments.py:452
msgid "'project' must be the id of a network."
msgstr "„project“ muss die ID eines Netzes sein."

#: brick_dnn_core/experiments.py:498
msgid "Unknown sort column '%(sort)s'."
msgstr "Unbekannte Sortierspalte „%(sort)s“."

#: brick_dnn_core/experiments.py:546
msgid "Compare at most %(count)d runs at a time."
msgstr "Vergleichen Sie höchstens %(count)d Läufe auf einmal."

#: brick_dnn_core/experiments.py:652
msgid "A run has at most %(count)d tags."
msgstr "Ein Lauf hat höchstens %(count)d Tags."

#: brick_dnn_core/experiments.py:671
msgid "'note' must be text."
msgstr "„note“ muss Text sein."

#: brick_dnn_core/experiments.py:681
msgid "'starred' must be true or false."
msgstr "„starred“ muss true oder false sein."

#: brick_dnn_core/experiments.py:761
msgid "The columns must be a list of at most %(count)d column names."
msgstr ""
"Die Spalten müssen eine Liste von höchstens %(count)d Spaltennamen sein."

#: brick_dnn_core/experiments.py:793
msgid "'smoothing' must be a number from 0 to 0.99."
msgstr "„smoothing“ muss eine Zahl von 0 bis 0,99 sein."

#: brick_dnn_core/experiments.py:843
msgid "You can have at most %(count)d shared comparisons. Delete one first."
msgstr ""
"Sie können höchstens %(count)d geteilte Vergleiche haben. Löschen Sie zuerst einen."

#: brick_dnn_core/experiments.py:377
msgid "'%(name)s' must be a whole number."
msgstr "„%(name)s“ muss eine ganze Zahl sein."

#: brick_dnn_core/experiments.py:646
msgid "A tag has at most %(count)d characters."
msgstr "Ein Tag hat höchstens %(count)d Zeichen."

#: brick_dnn_core/experiments.py:675
msgid "A note has at most %(count)d characters."
msgstr "Eine Notiz hat höchstens %(count)d Zeichen."

#: brick_dnn_core/experiments.py:787
msgid "The option '%(name)s' is not valid."
msgstr "Die Option „%(name)s“ ist ungültig."

#: brick_dnn_core/experiments.py:825
msgid "No such training run: '%(id)s'."
msgstr "Diesen Trainingslauf gibt es nicht: „%(id)s“."

#: brick_dnn_core/experiments.py:828
msgid ""
"'%(name)s' was started by someone else in a network you do not own: share only your own runs and runs of your networks."
msgstr ""
"„%(name)s“ hat jemand anderes in einem Netz gestartet, das Ihnen nicht gehört: Teilen Sie nur eigene Läufe und Läufe Ihrer Netze."

#: brick_dnn_core/legal.py:35
msgid "Imprint"
msgstr "Impressum"

#: brick_dnn_core/legal.py:36
msgid "Privacy policy"
msgstr "Datenschutzerklärung"

#: brick_dnn_core/legal.py:37
msgid "Terms of use"
msgstr "Nutzungsbedingungen"

#: brick_dnn_core/legal.py:38
msgid "Refund policy"
msgstr "Erstattung"

#: brick_dnn_core/legal.py:40
msgid "Accessibility statement"
msgstr "Erklärung zur Barrierefreiheit"

#: brick_dnn_core/legal.py:150
msgid "This page has not been set up on this server."
msgstr "Diese Seite ist auf diesem Server nicht eingerichtet."

#: brick_dnn_core/mail.py:84
msgid "Hello,"
msgstr "Hallo,"

#: brick_dnn_core/notices.py:62
msgid ""
"If this was not you, change your password right away and turn on two-factor authentication on your account page, or ask the operator of the site for help."
msgstr ""
"Falls Sie das nicht waren, ändern Sie sofort Ihr Passwort und schalten Sie auf Ihrer Kontoseite die Zwei-Faktor-Authentifizierung ein, oder bitten Sie den Betreiber der Seite um Hilfe."

#: brick_dnn_core/notices.py:47
msgid ""
"You get this e-mail because of your account “%(username)s” at %(site)s."
msgstr ""
"Sie erhalten diese E-Mail wegen Ihres Kontos „%(username)s“ bei %(site)s."

#: brick_dnn_core/notices.py:54
msgid "Hello %(username)s,"
msgstr "Hallo %(username)s,"

#: brick_dnn_core/notices.py:58
msgid "Open your account"
msgstr "Zu Ihrem Konto"

#: brick_dnn_core/notices.py:154
msgid "Your password was changed"
msgstr "Ihr Passwort wurde geändert"

#: brick_dnn_core/notices.py:164
msgid "Your e-mail address was changed"
msgstr "Ihre E-Mail-Adresse wurde geändert"

#: brick_dnn_core/notices.py:180
msgid "Two-factor authentication turned on"
msgstr "Zwei-Faktor-Authentifizierung eingeschaltet"

#: brick_dnn_core/notices.py:181
msgid ""
"Two-factor authentication is now on for your account: logging in needs a code from your authenticator app. Keep your recovery codes in a safe place."
msgstr ""
"Die Zwei-Faktor-Authentifizierung ist für Ihr Konto jetzt eingeschaltet: Zum Anmelden brauchen Sie einen Code aus Ihrer Authenticator-App. Bewahren Sie Ihre Wiederherstellungscodes sicher auf."

#: brick_dnn_core/notices.py:186
msgid "Two-factor authentication turned off"
msgstr "Zwei-Faktor-Authentifizierung ausgeschaltet"

#: brick_dnn_core/notices.py:187
msgid ""
"Two-factor authentication was turned off for your account: logging in needs only your password now."
msgstr ""
"Die Zwei-Faktor-Authentifizierung wurde für Ihr Konto ausgeschaltet: Zum Anmelden genügt jetzt Ihr Passwort."

#: brick_dnn_core/notices.py:198
msgid "A new API token was created"
msgstr "Ein neues API-Token wurde erstellt"

#: brick_dnn_core/notices.py:215
msgid "An app was connected to your account"
msgstr "Eine App wurde mit Ihrem Konto verbunden"

#: brick_dnn_core/notices.py:155
msgid ""
"The password of your account was changed. All other logins were ended."
msgstr ""
"Das Passwort Ihres Kontos wurde geändert. Alle anderen Anmeldungen wurden beendet."

#: brick_dnn_core/notices.py:96
msgid "Confirm your e-mail address"
msgstr "Bestätigen Sie Ihre E-Mail-Adresse"

#: brick_dnn_core/notices.py:124
msgid "Reset your password"
msgstr "Passwort zurücksetzen"

#: brick_dnn_core/notices.py:166
msgid ""
"The e-mail address of your account was changed from %(old)s to %(new)s. Further e-mails go to the new address."
msgstr ""
"Die E-Mail-Adresse Ihres Kontos wurde von %(old)s in %(new)s geändert. Weitere E-Mails gehen an die neue Adresse."

#: brick_dnn_core/notices.py:200
msgid ""
"An API token named “%(name)s” was created for your account. Scripts and AI assistants can use it to work with your networks and data. You can delete it on the page API tokens."
msgstr ""
"Für Ihr Konto wurde ein API-Token namens „%(name)s“ erstellt. Skripte und KI-Assistenten können damit auf Ihre Netze und Daten zugreifen. Sie können es auf der Seite API-Token löschen."

#: brick_dnn_core/notices.py:217
msgid ""
"The app “%(app)s” was connected to your account (OAuth) and can now use your networks and data through the MCP server. You can disconnect it on the page API tokens."
msgstr ""
"Die App „%(app)s“ wurde mit Ihrem Konto verbunden (OAuth) und kann jetzt über den MCP-Server auf Ihre Netze und Daten zugreifen. Sie können die Verbindung auf der Seite API-Token trennen."

#: brick_dnn_core/notices.py:239
msgid "Your account will be deleted"
msgstr "Ihr Konto wird gelöscht"

#: brick_dnn_core/notices.py:105
msgid "Confirm my e-mail address"
msgstr "E-Mail-Adresse bestätigen"

#: brick_dnn_core/notices.py:127
msgid ""
"Someone asked to reset the password of your account. If it was you, choose a new password with this link. It is valid for one hour and works once."
msgstr ""
"Jemand hat angefordert, das Passwort Ihres Kontos zurückzusetzen. Wenn Sie das waren, legen Sie mit diesem Link ein neues Passwort fest. Er gilt eine Stunde und funktioniert einmal."

#: brick_dnn_core/notices.py:132
msgid "Choose a new password"
msgstr "Neues Passwort festlegen"

#: brick_dnn_core/notices.py:134
msgid ""
"If you did not ask for this, ignore this e-mail: your password stays as it is. Two-factor authentication, if you turned it on, stays on after a reset."
msgstr ""
"Falls Sie das nicht angefordert haben, ignorieren Sie diese E-Mail: Ihr Passwort bleibt unverändert. Eine eingeschaltete Zwei-Faktor-Authentifizierung bleibt auch nach dem Zurücksetzen eingeschaltet."

#: brick_dnn_core/notices.py:252
msgid ""
"To keep it, simply log in before then. If you do not need it any more, you do not have to do anything; you can also download your data on the account page first."
msgstr ""
"Um es zu behalten, melden Sie sich einfach vorher an. Wenn Sie es nicht mehr brauchen, müssen Sie nichts tun; Sie können vorher auch Ihre Daten auf der Kontoseite herunterladen."

#: brick_dnn_core/notices.py:258
msgid "Log in to keep my account"
msgstr "Anmelden und Konto behalten"

#: brick_dnn_core/notices.py:99
msgid ""
"Please confirm that %(email)s is the e-mail address of your account. Open the link and log in if you are asked to."
msgstr ""
"Bitte bestätigen Sie, dass %(email)s die E-Mail-Adresse Ihres Kontos ist. Öffnen Sie den Link und melden Sie sich an, falls Sie dazu aufgefordert werden."

#: brick_dnn_core/notices.py:107
msgid ""
"The link is valid for %(days)d days. If you did not sign up or change your address, ignore this e-mail: nothing changes without the link."
msgstr ""
"Der Link gilt %(days)d Tage. Falls Sie sich nicht registriert oder Ihre Adresse nicht geändert haben, ignorieren Sie diese E-Mail: Ohne den Link ändert sich nichts."

#: brick_dnn_core/notices.py:242
msgid ""
"Nobody has used your account for a long time. Accounts that are not used for %(days)d days are deleted with everything in them: your networks, data and trainings. Yours will be deleted on or after %(date)s."
msgstr ""
"Ihr Konto wurde lange nicht benutzt. Konten, die %(days)d Tage lang nicht benutzt werden, werden mit allem gelöscht, was darin ist: Ihren Netzen, Daten und Trainings. Ihres wird am %(date)s oder danach gelöscht."

#: brick_dnn_core/notices.py:250
msgid "j F Y"
msgstr "j. F Y"

#: brick_dnn_core/recovery.py:59
msgid ""
"Password reset is not available on this server: it sends no e-mail. Ask its operator for help."
msgstr ""
"Auf diesem Server kann das Passwort nicht zurückgesetzt werden: Er verschickt keine E-Mails. Wenden Sie sich an den Betreiber."

#: brick_dnn_core/recovery.py:62
msgid ""
"If an account with this username or e-mail address exists and its e-mail address may receive reset links, we sent a link to it. It is valid for one hour."
msgstr ""
"Falls es ein Konto mit diesem Benutzernamen oder dieser E-Mail-Adresse gibt und an dessen Adresse Links zum Zurücksetzen gehen dürfen, haben wir einen Link dorthin geschickt. Er gilt eine Stunde."

#: brick_dnn_core/recovery.py:66
msgid "This link is invalid or has expired. Ask for a new one."
msgstr "Dieser Link ist ungültig oder abgelaufen. Fordern Sie einen neuen an."

#: brick_dnn_core/recovery.py:184
msgid ""
"This link is for another account. Log in with the account it was sent to."
msgstr ""
"Dieser Link gehört zu einem anderen Konto. Melden Sie sich mit dem Konto an, an das er geschickt wurde."

#: brick_dnn_core/recovery.py:191
msgid "This link is for an e-mail address the account does not use any more."
msgstr ""
"Dieser Link gehört zu einer E-Mail-Adresse, die das Konto nicht mehr verwendet."

#: brick_dnn_core/recovery.py:216
msgid "Add an e-mail address first."
msgstr "Hinterlegen Sie zuerst eine E-Mail-Adresse."

#: brick_dnn_core/recovery.py:367
msgid "Your password was changed. Log in with the new one."
msgstr "Ihr Passwort wurde geändert. Melden Sie sich mit dem neuen an."

#: brick_dnn_core/recovery.py:209
msgid "This server sends no e-mail, so addresses cannot be confirmed."
msgstr ""
"Dieser Server verschickt keine E-Mails, daher können Adressen nicht bestätigt werden."

#: brick_dnn_core/recovery.py:218
msgid "Your e-mail address is confirmed already."
msgstr "Ihre E-Mail-Adresse ist bereits bestätigt."

#: brick_dnn_core/recovery.py:220
msgid "We sent a link to %(email)s."
msgstr "Wir haben einen Link an %(email)s geschickt."

#: brick_dnn_core/serializers.py:81
msgid "An account with this e-mail address exists already."
msgstr "Es gibt bereits ein Konto mit dieser E-Mail-Adresse."

#: brick_dnn_core/serializers.py:67
msgid "Enter your e-mail address."
msgstr "Geben Sie Ihre E-Mail-Adresse ein."

#: brick_dnn_core/serializers.py:106
msgid "A user with that username already exists."
msgstr "Dieser Benutzername ist bereits vergeben."

#: brick_dnn_core/serializers.py:113
msgid "Please agree to the terms of use to create an account."
msgstr ""
"Bitte stimmen Sie den Nutzungsbedingungen zu, um ein Konto zu erstellen."

#: brick_dnn_core/tracking.py:163
msgid "The config may only hold numbers, text, lists and objects."
msgstr ""
"Die Konfiguration darf nur Zahlen, Text, Listen und Objekte enthalten."

#: brick_dnn_core/tracking.py:362
msgid "Run from a script"
msgstr "Lauf aus einem Skript"

#: brick_dnn_core/tracking.py:363
msgid "Elsewhere"
msgstr "Anderswo"

#: brick_dnn_core/tracking.py:170
msgid "'config' must be an object."
msgstr "„config“ muss ein Objekt sein."

#: brick_dnn_core/tracking.py:186
msgid "'summary' must be an object of numbers."
msgstr "„summary“ muss ein Objekt aus Zahlen sein."

#: brick_dnn_core/tracking.py:193
msgid "Summary"
msgstr "Zusammenfassung"

#: brick_dnn_core/tracking.py:210
msgid "'points' must be a list of points."
msgstr "„points“ muss eine Liste von Punkten sein."

#: brick_dnn_core/tracking.py:219
msgid "Point %(index)d"
msgstr "Punkt %(index)d"

#: brick_dnn_core/tracking.py:313
msgid "Send the run as a JSON object."
msgstr "Senden Sie den Lauf als JSON-Objekt."

#: brick_dnn_core/tracking.py:353
msgid "'task' must be classification, regression or segmentation."
msgstr "„task“ muss classification, regression oder segmentation sein."

#: brick_dnn_core/tracking.py:358
msgid "'epochs' must be a whole number from 1."
msgstr "„epochs“ muss eine ganze Zahl ab 1 sein."

#: brick_dnn_core/tracking.py:392
msgid "Logging from a script elsewhere."
msgstr "Ein Skript anderswo protokolliert diesen Lauf."

#: brick_dnn_core/tracking.py:417
msgid "Send the points as {\"points\": [...]}."
msgstr "Senden Sie die Punkte als {\"points\": [...]}."

#: brick_dnn_core/tracking.py:464
msgid "Send the changes as a JSON object."
msgstr "Senden Sie die Änderungen als JSON-Objekt."

#: brick_dnn_core/tracking.py:485
msgid "Send the end of the run as a JSON object."
msgstr "Senden Sie das Ende des Laufs als JSON-Objekt."

#: brick_dnn_core/tracking.py:488
msgid "'status' must be completed, failed or stopped."
msgstr "„status“ muss completed, failed oder stopped sein."

#: brick_dnn_core/tracking.py:523
msgid "The script stopped reporting: nothing arrived for 24 hours."
msgstr ""
"Das Skript meldet sich nicht mehr: Seit 24 Stunden ist nichts angekommen."

#: brick_dnn_core/tracking.py:125
msgid "'%(field)s' must be text."
msgstr "„%(field)s“ muss Text sein."

#: brick_dnn_core/tracking.py:133
msgid ""
"%(where)s: '%(name)s' is not a metric name (letters, digits and _ . / -, starting with a letter, at most 64 characters)."
msgstr ""
"%(where)s: „%(name)s“ ist kein Metrikname (Buchstaben, Ziffern und _ . / -, beginnend mit einem Buchstaben, höchstens 64 Zeichen)."

#: brick_dnn_core/tracking.py:148
msgid "The config holds a number that is not finite."
msgstr "Die Konfiguration enthält eine Zahl, die nicht endlich ist."

#: brick_dnn_core/tracking.py:154
msgid "The config is nested too deeply (at most %(depth)d levels)."
msgstr ""
"Die Konfiguration ist zu tief verschachtelt (höchstens %(depth)d Ebenen)."

#: brick_dnn_core/tracking.py:174
msgid "The config is too large (at most %(kb)d KB)."
msgstr "Die Konfiguration ist zu groß (höchstens %(kb)d KB)."

#: brick_dnn_core/tracking.py:189
msgid "A summary has at most %(count)d numbers."
msgstr "Eine Zusammenfassung hat höchstens %(count)d Zahlen."

#: brick_dnn_core/tracking.py:213
msgid "Send at most %(count)d points at a time."
msgstr "Senden Sie höchstens %(count)d Punkte auf einmal."

#: brick_dnn_core/tracking.py:300
msgid "This run has ended (%(status)s): it takes no more reports."
msgstr ""
"Dieser Lauf ist beendet (%(status)s): Er nimmt keine Meldungen mehr an."

#: brick_dnn_core/tracking.py:317
msgid ""
"Your account has %(count)d runs logged from elsewhere, the most it may keep. Delete some on the runs page."
msgstr ""
"Ihr Konto hat %(count)d anderswo protokollierte Läufe, so viele, wie es behalten darf. Löschen Sie einige auf der Seite „Läufe“."

#: brick_dnn_core/tracking.py:327
msgid ""
"%(count)d runs of your account are logging at the moment, the most at a time. Finish one first."
msgstr ""
"Gerade protokollieren %(count)d Läufe Ihres Kontos, die meisten, die gleichzeitig erlaubt sind. Beenden Sie zuerst einen."

#: brick_dnn_core/tracking.py:538
msgid "Stopped in Brick DNN; the script's further reports are refused."
msgstr ""
"In Brick DNN gestoppt; weitere Meldungen des Skripts werden abgelehnt."

#: brick_dnn_core/tracking.py:665
msgid "No such run logged from elsewhere."
msgstr "Diesen anderswo protokollierten Lauf gibt es nicht."

#: brick_dnn_core/tracking.py:199
msgid "Summary: '%(name)s' must be a finite number."
msgstr "Zusammenfassung: „%(name)s“ muss eine endliche Zahl sein."

#: brick_dnn_core/tracking.py:221
msgid "%(where)s is not an object."
msgstr "%(where)s ist kein Objekt."

#: brick_dnn_core/tracking.py:233
msgid "%(where)s needs an epoch or a step."
msgstr "%(where)s braucht eine Epoche oder einen Schritt."

#: brick_dnn_core/tracking.py:245
msgid "%(where)s has more than %(count)d metrics."
msgstr "%(where)s hat mehr als %(count)d Metriken."

#: brick_dnn_core/tracking.py:347
msgid "Network %(id)d is not one you own or edit."
msgstr "Netz %(id)d gehört Ihnen nicht, und Sie bearbeiten es nicht."

#: brick_dnn_core/tracking.py:431
msgid ""
"A run logged from elsewhere keeps at most %(count)d points; this one has %(has)d. Log less often (e.g. once per epoch)."
msgstr ""
"Ein anderswo protokollierter Lauf behält höchstens %(count)d Punkte; dieser hat %(has)d. Protokollieren Sie seltener (z. B. einmal pro Epoche)."

#: brick_dnn_core/tracking.py:499
msgid "Finished elsewhere."
msgstr "Anderswo abgeschlossen."

#: brick_dnn_core/tracking.py:500
msgid "The script reported a failure."
msgstr "Das Skript hat einen Fehler gemeldet."

#: brick_dnn_core/tracking.py:501
msgid "Stopped elsewhere."
msgstr "Anderswo gestoppt."

#: brick_dnn_core/tracking.py:238
msgid "%(where)s: 'time' must be the seconds since the start."
msgstr "%(where)s: „time“ müssen die Sekunden seit dem Start sein."

#: brick_dnn_core/tracking.py:256
msgid "%(where)s: '%(name)s' must be a finite number."
msgstr "%(where)s: „%(name)s“ muss eine endliche Zahl sein."

#: brick_dnn_core/tracking.py:228
msgid "%(where)s: '%(key)s' must be a whole number from 0."
msgstr "%(where)s: „%(key)s“ muss eine ganze Zahl ab 0 sein."

#: brick_dnn_core/tracking.py:652
msgid "A request may hold at most %(kb)d KB: send fewer points at a time."
msgstr ""
"Eine Anfrage darf höchstens %(kb)d KB enthalten: Senden Sie weniger Punkte auf einmal."

#: brick_dnn_core/two_factor.py:348
msgid "The login has expired. Log in again."
msgstr "Die Anmeldung ist abgelaufen. Melden Sie sich erneut an."

#: brick_dnn_core/two_factor.py:401
msgid "The code is wrong or was used already."
msgstr "Der Code ist falsch oder wurde bereits verwendet."

#: brick_dnn_core/two_factor.py:423
msgid "Two-factor authentication is on already."
msgstr "Die Zwei-Faktor-Authentifizierung ist bereits eingeschaltet."

#: brick_dnn_core/two_factor.py:447
msgid "Start the setup first."
msgstr "Starten Sie zuerst die Einrichtung."

#: brick_dnn_core/two_factor.py:491
msgid "Two-factor authentication is off."
msgstr "Die Zwei-Faktor-Authentifizierung ist ausgeschaltet."

#: brick_dnn_core/two_factor.py:455
msgid "The code is wrong. Check the app."
msgstr "Der Code ist falsch. Prüfen Sie die App."

#: brick_dnn_core/views.py:481
msgid ""
"Only who started the run and the editors of its network can change this."
msgstr ""
"Das können nur, wer den Lauf gestartet hat, und die Bearbeiter seines Netzes ändern."

#: brick_dnn_core/views.py:125
msgid "Registration is disabled on this server."
msgstr "Die Registrierung ist auf diesem Server deaktiviert."

#: brick_dnn_core/templates/brick_dnn_core/email/base.html
msgid "If the button does not work, copy this address into your browser:"
msgstr ""
"Falls der Button nicht funktioniert, kopieren Sie diese Adresse in Ihren Browser:"

#: catalog
msgid ""
"Entry point of the network. The shape excludes the batch dimension, e.g. [784] for flat features, [3, 32, 32] for RGB images or [64] for 64 token ids."
msgstr ""
"Einstiegspunkt des Netzes. Die Form ohne die Batch-Dimension, z. B. [784] für flache Merkmale, [3, 32, 32] für RGB-Bilder oder [64] für 64 Token-IDs."

#: catalog
msgid "Shape"
msgstr "Form"

#: catalog
msgid "Tensor shape without the batch dimension."
msgstr "Tensor-Form ohne die Batch-Dimension."

#: catalog
msgid "Data type"
msgstr "Datentyp"

#: catalog
msgid "Use 'long' for integer token ids that feed an Embedding layer."
msgstr ""
"'long' für ganzzahlige Token-IDs, die in eine Embedding-Schicht gehen."

#: catalog
msgid "Fully connected layer: y = xWᵀ + b. Applied to the last dimension."
msgstr ""
"Vollständig verbundene Schicht: y = xWᵀ + b. Wirkt auf die letzte Dimension."

#: catalog
msgid "Input features"
msgstr "Eingabemerkmale"

#: catalog
msgid "Leave empty to infer it from the input shape."
msgstr "Leer lassen, um den Wert aus der Eingabeform abzuleiten."

#: catalog
msgid "Output features"
msgstr "Ausgabemerkmale"

#: catalog
msgid "Bias"
msgstr "Bias"

#: catalog
msgid "Input"
msgstr "Eingabe"

#: catalog
msgid "Flattens all dimensions except the batch into one feature vector."
msgstr ""
"Fasst alle Dimensionen außer der Batch-Dimension zu einem Merkmalsvektor zusammen."

#: catalog
msgid ""
"Reshapes the tensor (batch dimension excluded). One entry may be -1 to infer it, e.g. [784] → [1, 28, 28]."
msgstr ""
"Formt den Tensor um (ohne Batch-Dimension). Ein Eintrag darf -1 sein und wird dann abgeleitet, z. B. [784] → [1, 28, 28]."

#: catalog
msgid "Target shape"
msgstr "Zielform"

#: catalog
msgid "Shape without the batch dimension. Use -1 once to infer a dimension."
msgstr ""
"Form ohne die Batch-Dimension. -1 einmal verwenden, um eine Dimension abzuleiten."

#: catalog
msgid ""
"Randomly zeroes elements with probability p during training (regularisation)."
msgstr ""
"Setzt während des Trainings Elemente zufällig mit Wahrscheinlichkeit p auf null (Regularisierung)."

#: catalog
msgid "Drop probability"
msgstr "Dropout-Wahrscheinlichkeit"

#: catalog
msgid "Element-wise non-linearity such as ReLU, GELU or Sigmoid."
msgstr "Elementweise Nichtlinearität wie ReLU, GELU oder Sigmoid."

#: catalog
msgid "Function"
msgstr "Funktion"

#: catalog
msgid ""
"1-D convolution over (channels, length), e.g. for audio or time series."
msgstr "1-D-Faltung über (Kanäle, Länge), z. B. für Audio oder Zeitreihen."

#: catalog
msgid "Input channels"
msgstr "Eingabekanäle"

#: catalog
msgid "Output channels (filters)"
msgstr "Ausgabekanäle (Filter)"

#: catalog
msgid "Kernel size"
msgstr "Kernelgröße"

#: catalog
msgid "Stride"
msgstr "Schrittweite (Stride)"

#: catalog
msgid "Padding"
msgstr "Padding"

#: catalog
msgid "'same' keeps the spatial size, 'valid' adds no padding."
msgstr ""
"'same' behält die räumliche Größe bei, 'valid' fügt kein Padding hinzu."

#: catalog
msgid "Padding size"
msgstr "Padding-Größe"

#: catalog
msgid ""
"2-D convolution over (channels, height, width), the workhorse of image models."
msgstr ""
"2-D-Faltung über (Kanäle, Höhe, Breite), das Arbeitspferd der Bildmodelle."

#: catalog
msgid ""
"Transposed 2-D convolution: upsamples (channels, height, width) with learned weights, e.g. in the decoder of a U-Net or an autoencoder. Kernel 2 with stride 2 doubles the size."
msgstr ""
"Transponierte 2-D-Faltung: vergrößert (Kanäle, Höhe, Breite) mit gelernten Gewichten, z. B. im Decoder eines U-Nets oder Autoencoders. Kernel 2 mit Stride 2 verdoppelt die Größe."

#: catalog
msgid "Removes this many rows and columns from every side of the output."
msgstr "Entfernt so viele Zeilen und Spalten an jeder Seite der Ausgabe."

#: catalog
msgid "Output padding"
msgstr "Ausgabe-Padding"

#: catalog
msgid ""
"Extra rows and columns on one side of the output (must be below the stride)."
msgstr ""
"Zusätzliche Zeilen und Spalten an einer Seite der Ausgabe (muss kleiner als der Stride sein)."

#: catalog
msgid "Downsamples (channels, length) by taking the maximum in each window."
msgstr ""
"Verkleinert (Kanäle, Länge), indem es in jedem Fenster das Maximum nimmt."

#: catalog
msgid "Leave empty to use the kernel size."
msgstr "Leer lassen, um die Kernelgröße zu verwenden."

#: catalog
msgid ""
"Downsamples (channels, height, width) by taking the maximum in each window."
msgstr ""
"Verkleinert (Kanäle, Höhe, Breite), indem es in jedem Fenster das Maximum nimmt."

#: catalog
msgid "Downsamples (channels, height, width) by averaging each window."
msgstr ""
"Verkleinert (Kanäle, Höhe, Breite), indem es über jedes Fenster mittelt."

#: catalog
msgid ""
"Averages each channel down to a fixed output size regardless of the input size. Output size 1×1 gives global average pooling."
msgstr ""
"Mittelt jeden Kanal auf eine feste Ausgabegröße, unabhängig von der Eingabegröße. Ausgabegröße 1×1 ergibt Global Average Pooling."

#: catalog
msgid "Output size"
msgstr "Ausgabegröße"

#: catalog
msgid "Batch normalisation for (features) or (channels, length) inputs."
msgstr ""
"Batch-Normalisierung für Eingaben der Form (Merkmale) oder (Kanäle, Länge)."

#: catalog
msgid "Features / channels"
msgstr "Merkmale / Kanäle"

#: catalog
msgid "Batch normalisation for (channels, height, width) inputs."
msgstr "Batch-Normalisierung für Eingaben der Form (Kanäle, Höhe, Breite)."

#: catalog
msgid "Normalises over the last dimension. Standard in Transformers."
msgstr "Normalisiert über die letzte Dimension. Standard in Transformern."

#: catalog
msgid "Features"
msgstr "Merkmale"

#: catalog
msgid ""
"Maps integer token ids to dense vectors. Needs an Input with data type 'long'."
msgstr ""
"Bildet ganzzahlige Token-IDs auf dichte Vektoren ab. Braucht eine Eingabe mit Datentyp 'long'."

#: catalog
msgid "Vocabulary size"
msgstr "Vokabulargröße"

#: catalog
msgid "Embedding size"
msgstr "Embedding-Größe"

#: catalog
msgid ""
"Adds a learned position vector to every step of a (sequence, features) tensor, so that Transformers know the order of the tokens."
msgstr ""
"Addiert zu jedem Schritt eines Tensors (Sequenz, Merkmale) einen gelernten Positionsvektor, damit Transformer die Reihenfolge der Token kennen."

#: catalog
msgid "Max. sequence length"
msgstr "Max. Sequenzlänge"

#: catalog
msgid "Vanilla recurrent layer over a (sequence, features) input."
msgstr "Einfache rekurrente Schicht über eine Eingabe (Sequenz, Merkmale)."

#: catalog
msgid "Hidden size"
msgstr "Größe des Hidden State"

#: catalog
msgid "Stacked layers"
msgstr "Gestapelte Schichten"

#: catalog
msgid "Bidirectional"
msgstr "Bidirektional"

#: catalog
msgid "Return sequences"
msgstr "Sequenzen ausgeben"

#: catalog
msgid ""
"Output every time step (sequence, features) instead of only the last one."
msgstr "Jeden Zeitschritt ausgeben (Sequenz, Merkmale) statt nur den letzten."

#: catalog
msgid "Long short-term memory layer over a (sequence, features) input."
msgstr "Long-Short-Term-Memory-Schicht über eine Eingabe (Sequenz, Merkmale)."

#: catalog
msgid "Gated recurrent unit layer over a (sequence, features) input."
msgstr "Gated-Recurrent-Unit-Schicht über eine Eingabe (Sequenz, Merkmale)."

#: catalog
msgid ""
"Stack of self-attention encoder blocks over a (sequence, features) input."
msgstr ""
"Stapel von Self-Attention-Encoder-Blöcken über eine Eingabe (Sequenz, Merkmale)."

#: catalog
msgid "Model dimension"
msgstr "Modelldimension"

#: catalog
msgid "Attention heads"
msgstr "Attention-Heads"

#: catalog
msgid "Feed-forward size"
msgstr "Größe des Feed-Forward-Netzes"

#: catalog
msgid "Dropout"
msgstr "Dropout"

#: catalog
msgid ""
"Reduces a (sequence, features) tensor to (features) by taking the mean, max, first or last step. Typical before a classification head."
msgstr ""
"Reduziert einen Tensor (Sequenz, Merkmale) auf (Merkmale) über den Mittelwert, das Maximum, den ersten oder den letzten Schritt. Typisch vor einem Klassifikationskopf."

#: catalog
msgid "Mode"
msgstr "Modus"

#: catalog
msgid ""
"Element-wise sum of two or more tensors of equal shape (residual connections)."
msgstr ""
"Elementweise Summe von zwei oder mehr Tensoren gleicher Form (Residualverbindungen)."

#: catalog
msgid ""
"Concatenates two or more tensors along one dimension (batch excluded; -1 = last dimension). Inputs are joined in connection order."
msgstr ""
"Verkettet zwei oder mehr Tensoren entlang einer Dimension (ohne Batch; -1 = letzte Dimension). Die Eingaben werden in der Reihenfolge der Verbindungen aneinandergehängt."

#: catalog
msgid "Dimension"
msgstr "Dimension"

#: catalog
msgid "RBF kernel"
msgstr "RBF-Kernel"

#: catalog
msgid ""
"Radial basis function (squared exponential) kernel for smooth functions. The most common kernel of Gaussian processes."
msgstr ""
"Radiale-Basisfunktion-Kernel (quadratisch exponentiell) für glatte Funktionen. Der häufigste Kernel von Gauß-Prozessen."

#: catalog
msgid "Length scale"
msgstr "Längenskala"

#: catalog
msgid ""
"How far apart (in standardised feature units) inputs still look alike. Initial value: the Gaussian process optimises it unless it is fixed."
msgstr ""
"Wie weit Eingaben (in standardisierten Merkmalseinheiten) auseinanderliegen dürfen und noch ähnlich wirken. Startwert: Der Gauß-Prozess optimiert ihn, sofern er nicht festgelegt ist."

#: catalog
msgid "Hyperparameters"
msgstr "Hyperparameter"

#: catalog
msgid ""
"optimize: the Gaussian process fits them to the training data, starting from the values above (within 1e-05 … 1e+05); custom bounds: within the bounds below; fixed: they keep these values."
msgstr ""
"optimize: Der Gauß-Prozess passt sie an die Trainingsdaten an, ausgehend von den Werten oben (zwischen 1e-05 … 1e+05); custom bounds: innerhalb der Grenzen unten; fixed: Sie behalten diese Werte."

#: catalog
msgid "Length scale: lower bound"
msgstr "Längenskala: untere Grenze"

#: catalog
msgid "Length scale: upper bound"
msgstr "Längenskala: obere Grenze"

#: catalog
msgid "Matérn kernel"
msgstr "Matérn-Kernel"

#: catalog
msgid ""
"Like RBF, but for rougher functions: ν = 0.5 is the exponential kernel, 1.5 gives once and 2.5 twice differentiable functions."
msgstr ""
"Wie RBF, aber für rauere Funktionen: ν = 0,5 ist der Exponentialkernel, 1,5 ergibt einmal und 2,5 zweimal differenzierbare Funktionen."

#: catalog
msgid "Smoothness ν"
msgstr "Glattheit ν"

#: catalog
msgid "Smaller values give rougher functions (ν is not optimised)."
msgstr "Kleinere Werte ergeben rauere Funktionen (ν wird nicht optimiert)."

#: catalog
msgid "Rational quadratic kernel"
msgstr "Rational-quadratischer Kernel"

#: catalog
msgid ""
"A mixture of RBF kernels of different length scales; alpha weights the mixture."
msgstr ""
"Eine Mischung von RBF-Kerneln verschiedener Längenskalen; alpha gewichtet die Mischung."

#: catalog
msgid "Alpha"
msgstr "Alpha"

#: catalog
msgid "Weighting of large and small length scales (large values: like RBF)."
msgstr "Gewichtung großer und kleiner Längenskalen (große Werte: wie RBF)."

#: catalog
msgid "Alpha: lower bound"
msgstr "Alpha: untere Grenze"

#: catalog
msgid "Alpha: upper bound"
msgstr "Alpha: obere Grenze"

#: catalog
msgid "Periodic kernel"
msgstr "Periodischer Kernel"

#: catalog
msgid ""
"Exp-sine-squared kernel for periodic functions: the periodicity is the distance after which the function repeats."
msgstr ""
"Exp-Sine-Squared-Kernel für periodische Funktionen: Die Periodizität ist der Abstand, nach dem sich die Funktion wiederholt."

#: catalog
msgid "Periodicity"
msgstr "Periodizität"

#: catalog
msgid ""
"Period in standardised feature units (the features are standardised before the kernel sees them)."
msgstr ""
"Periode in standardisierten Merkmalseinheiten (die Merkmale werden standardisiert, bevor der Kernel sie sieht)."

#: catalog
msgid "Periodicity: lower bound"
msgstr "Periodizität: untere Grenze"

#: catalog
msgid "Periodicity: upper bound"
msgstr "Periodizität: obere Grenze"

#: catalog
msgid "Dot product kernel"
msgstr "Skalarprodukt-Kernel"

#: catalog
msgid ""
"Linear kernel σ₀² + x·x′ (Bayesian linear regression). Multiply it with itself for polynomial trends."
msgstr ""
"Linearer Kernel σ₀² + x·x′ (bayessche lineare Regression). Mit sich selbst multipliziert für polynomiale Trends."

#: catalog
msgid "Sigma₀"
msgstr "Sigma₀"

#: catalog
msgid "Inhomogeneity (offset)."
msgstr "Inhomogenität (Offset)."

#: catalog
msgid "Sigma₀: lower bound"
msgstr "Sigma₀: untere Grenze"

#: catalog
msgid "Sigma₀: upper bound"
msgstr "Sigma₀: obere Grenze"

#: catalog
msgid "White noise kernel"
msgstr "Weißes-Rauschen-Kernel"

#: catalog
msgid ""
"Independent noise on every sample. Add it (KernelSum) to learn how noisy the targets are."
msgstr ""
"Unabhängiges Rauschen auf jeder Stichprobe. Addieren Sie ihn (KernelSum), um zu lernen, wie verrauscht die Zielwerte sind."

#: catalog
msgid "Noise level"
msgstr "Rauschniveau"

#: catalog
msgid ""
"Noise variance (of the standardised targets if Normalize targets is on)."
msgstr ""
"Rauschvarianz (der standardisierten Zielwerte, wenn Normalize targets eingeschaltet ist)."

#: catalog
msgid "Noise level: lower bound"
msgstr "Rauschniveau: untere Grenze"

#: catalog
msgid "Noise level: upper bound"
msgstr "Rauschniveau: obere Grenze"

#: catalog
msgid "Constant kernel"
msgstr "Konstanter Kernel"

#: catalog
msgid ""
"A constant: multiply another kernel with it (KernelProduct) to scale that kernel, add it (KernelSum) for a constant offset."
msgstr ""
"Eine Konstante: Multiplizieren Sie einen anderen Kernel damit (KernelProduct), um ihn zu skalieren, oder addieren Sie sie (KernelSum) für einen konstanten Offset."

#: catalog
msgid "Constant"
msgstr "Konstante"

#: catalog
msgid "Constant: lower bound"
msgstr "Konstante: untere Grenze"

#: catalog
msgid "Constant: upper bound"
msgstr "Konstante: obere Grenze"

#: catalog
msgid "Kernel sum"
msgstr "Kernel-Summe"

#: catalog
msgid ""
"Adds two or more kernels, e.g. RBF + WhiteKernel for a smooth function with noise."
msgstr ""
"Addiert zwei oder mehr Kernel, z. B. RBF + WhiteKernel für eine glatte Funktion mit Rauschen."

#: catalog
msgid "Kernels"
msgstr "Kernel"

#: catalog
msgid "Kernel product"
msgstr "Kernel-Produkt"

#: catalog
msgid ""
"Multiplies two or more kernels, e.g. ConstantKernel × RBF to scale a kernel, or RBF × ExpSineSquared for a slowly changing periodic pattern."
msgstr ""
"Multipliziert zwei oder mehr Kernel, z. B. ConstantKernel × RBF, um einen Kernel zu skalieren, oder RBF × ExpSineSquared für ein sich langsam änderndes periodisches Muster."

#: catalog
msgid "Gaussian process regression"
msgstr "Gauß-Prozess-Regression"

#: catalog
msgid ""
"Predicts a number with its uncertainty. Connect the Input (features) and optionally a kernel; without one it uses ConstantKernel × RBF + WhiteKernel. Fitting takes O(n³): for up to a few thousand training rows."
msgstr ""
"Sagt eine Zahl mit ihrer Unsicherheit vorher. Verbinden Sie die Eingabe (Merkmale) und optional einen Kernel; ohne Kernel wird ConstantKernel × RBF + WhiteKernel verwendet. Das Anpassen braucht O(n³): für bis zu einige Tausend Trainingszeilen."

#: catalog
msgid ""
"Added to the diagonal of the kernel matrix: keeps the fit numerically stable. To learn the noise of the targets, add a WhiteKernel instead."
msgstr ""
"Wird zur Diagonale der Kernelmatrix addiert und hält die Anpassung numerisch stabil. Um das Rauschen der Zielwerte zu lernen, fügen Sie stattdessen einen WhiteKernel hinzu."

#: catalog
msgid "Normalize targets"
msgstr "Zielwerte normalisieren"

#: catalog
msgid ""
"Standardise the targets before fitting (recommended unless they are already centred around 0 with variance 1)."
msgstr ""
"Standardisiert die Zielwerte vor dem Anpassen (empfohlen, außer sie sind bereits um 0 zentriert mit Varianz 1)."

#: catalog
msgid "Optimizer restarts"
msgstr "Neustarts des Optimierers"

#: catalog
msgid ""
"Fit the kernel hyperparameters again from this many random starting points and keep the best fit (slower, but less likely to get stuck)."
msgstr ""
"Passt die Kernel-Hyperparameter erneut von so vielen zufälligen Startpunkten aus an und behält die beste Anpassung (langsamer, bleibt aber seltener hängen)."

#: catalog
msgid "Kernel"
msgstr "Kernel"

#: catalog
msgid "Gaussian process classification"
msgstr "Gauß-Prozess-Klassifikation"

#: catalog
msgid ""
"Classifies with class probabilities (Laplace approximation; with more than two classes one Gaussian process per class). Connect the Input (features) and optionally a kernel; without one it uses ConstantKernel × RBF. The classes come from the data. Fitting takes O(n³) per class: for up to about two thousand training rows."
msgstr ""
"Klassifiziert mit Klassenwahrscheinlichkeiten (Laplace-Approximation; bei mehr als zwei Klassen ein Gauß-Prozess pro Klasse). Verbinden Sie die Eingabe (Merkmale) und optional einen Kernel; ohne Kernel wird ConstantKernel × RBF verwendet. Die Klassen kommen aus den Daten. Das Anpassen braucht O(n³) pro Klasse: für bis zu etwa zweitausend Trainingszeilen."

#: catalog
msgid "Support vector regression"
msgstr "Support-Vector-Regression"

#: catalog
msgid ""
"Predicts a number with an ε-insensitive support vector machine. Connect the Input (features). Fitting takes O(n²) or more: for up to tens of thousands of training rows."
msgstr ""
"Sagt eine Zahl mit einer ε-insensitiven Support Vector Machine vorher. Verbinden Sie die Eingabe (Merkmale). Das Anpassen braucht O(n²) oder mehr: für bis zu einige Zehntausend Trainingszeilen."

#: catalog
msgid ""
"The SVM's own kernel (kernel bricks only work with Gaussian processes)."
msgstr ""
"Der eigene Kernel der SVM (Kernel-Bausteine funktionieren nur mit Gauß-Prozessen)."

#: catalog
msgid "C (regularisation)"
msgstr "C (Regularisierung)"

#: catalog
msgid ""
"Larger values fit the training data more closely, smaller ones regularise more."
msgstr ""
"Größere Werte passen sich enger an die Trainingsdaten an, kleinere regularisieren stärker."

#: catalog
msgid "Gamma"
msgstr "Gamma"

#: catalog
msgid ""
"Coefficient of the rbf, poly and sigmoid kernels: scale = 1 / (features × variance), auto = 1 / features, or a value."
msgstr ""
"Koeffizient der Kernel rbf, poly und sigmoid: scale = 1 / (Merkmale × Varianz), auto = 1 / Merkmale, oder ein Wert."

#: catalog
msgid "Gamma value"
msgstr "Gamma-Wert"

#: catalog
msgid "Degree"
msgstr "Grad"

#: catalog
msgid "Coef0"
msgstr "Coef0"

#: catalog
msgid "Independent term of the poly and sigmoid kernels."
msgstr "Unabhängiger Term der Kernel poly und sigmoid."

#: catalog
msgid "Epsilon"
msgstr "Epsilon"

#: catalog
msgid ""
"Errors smaller than this (in the units of the target) are not penalised."
msgstr ""
"Fehler kleiner als dieser Wert (in Einheiten des Zielwerts) werden nicht bestraft."

#: catalog
msgid "Support vector classification"
msgstr "Support-Vector-Klassifikation"

#: catalog
msgid ""
"Classifies with a support vector machine; Platt scaling turns its scores into class probabilities. Connect the Input (features); the classes come from the data. Fitting takes O(n²) or more: for up to tens of thousands of training rows."
msgstr ""
"Klassifiziert mit einer Support Vector Machine; Platt-Skalierung macht aus ihren Scores Klassenwahrscheinlichkeiten. Verbinden Sie die Eingabe (Merkmale); die Klassen kommen aus den Daten. Das Anpassen braucht O(n²) oder mehr: für bis zu einige Zehntausend Trainingszeilen."

#: catalog
msgid "Class weights"
msgstr "Klassengewichte"

#: catalog
msgid ""
"balanced: weight the classes inversely to their frequency (for imbalanced data)."
msgstr ""
"balanced: gewichtet die Klassen umgekehrt proportional zu ihrer Häufigkeit (für unausgewogene Daten)."

#: catalog
msgid "Gradient boosting regression"
msgstr "Gradient-Boosting-Regression"

#: catalog
msgid ""
"Predicts a number with gradient-boosted decision trees (histogram-based): a strong baseline for tabular data. Connect the Input (features). The time to fit grows about linearly with the rows: for hundreds of thousands of training rows and more."
msgstr ""
"Sagt eine Zahl mit gradient-geboosteten Entscheidungsbäumen (histogrammbasiert) vorher: eine starke Baseline für Tabellendaten. Verbinden Sie die Eingabe (Merkmale). Die Zeit zum Anpassen wächst etwa linear mit den Zeilen: für Hunderttausende Trainingszeilen und mehr."

#: catalog
msgid "Learning rate"
msgstr "Lernrate"

#: catalog
msgid ""
"How much each tree corrects the trees before it. Smaller values need more iterations but often generalise better."
msgstr ""
"Wie stark jeder Baum die Bäume vor ihm korrigiert. Kleinere Werte brauchen mehr Iterationen, generalisieren aber oft besser."

#: catalog
msgid "Max. iterations"
msgstr "Max. Iterationen"

#: catalog
msgid ""
"Boosting iterations: one tree each (a classifier with more than two classes fits one tree per class and iteration). Early stopping may end sooner."
msgstr ""
"Boosting-Iterationen: je ein Baum (ein Klassifikator mit mehr als zwei Klassen passt pro Klasse und Iteration einen Baum an). Early Stopping kann früher enden."

#: catalog
msgid "Max. leaves per tree"
msgstr "Max. Blätter pro Baum"

#: catalog
msgid ""
"Limits the size of every tree. More leaves capture more interactions between the features."
msgstr ""
"Begrenzt die Größe jedes Baums. Mehr Blätter erfassen mehr Wechselwirkungen zwischen den Merkmalen."

#: catalog
msgid "Max. depth"
msgstr "Max. Tiefe"

#: catalog
msgid "Empty: no limit (Max. leaves per tree limits the trees instead)."
msgstr ""
"Leer: keine Grenze (stattdessen begrenzt Max. Blätter pro Baum die Bäume)."

#: catalog
msgid "Min. rows per leaf"
msgstr "Min. Zeilen pro Blatt"

#: catalog
msgid ""
"Every leaf holds at least this many training rows. Larger values regularise more."
msgstr ""
"Jedes Blatt enthält mindestens so viele Trainingszeilen. Größere Werte regularisieren stärker."

#: catalog
msgid "L2 regularisation"
msgstr "L2-Regularisierung"

#: catalog
msgid "Penalises large leaf values (0: none)."
msgstr "Bestraft große Blattwerte (0: keine)."

#: catalog
msgid "Early stopping"
msgstr "Early Stopping"

#: catalog
msgid ""
"Hold out 10 % of the training rows and stop when the loss on them has not improved for 10 iterations. auto: on above 10,000 training rows."
msgstr ""
"Hält 10 % der Trainingszeilen zurück und stoppt, wenn sich der Verlust darauf 10 Iterationen lang nicht verbessert hat. auto: an bei mehr als 10.000 Trainingszeilen."

#: catalog
msgid "Random state"
msgstr "Zufallsstartwert"

#: catalog
msgid ""
"Seed for the rows early stopping holds out and for the sample the feature bins are computed from (above 200,000 rows). The same seed gives the same model."
msgstr ""
"Startwert (Seed) für die Zeilen, die Early Stopping zurückhält, und für die Stichprobe, aus der die Merkmals-Bins berechnet werden (ab 200.000 Zeilen). Derselbe Seed ergibt dasselbe Modell."

#: catalog
msgid "Gradient boosting classification"
msgstr "Gradient-Boosting-Klassifikation"

#: catalog
msgid ""
"Classifies with gradient-boosted decision trees (histogram-based), with class probabilities: a strong baseline for tabular data. Connect the Input (features); the classes come from the data. For rare classes, set Class weights to balanced. The time to fit grows about linearly with the rows: for hundreds of thousands of training rows and more."
msgstr ""
"Klassifiziert mit gradient-geboosteten Entscheidungsbäumen (histogrammbasiert) mit Klassenwahrscheinlichkeiten: eine starke Baseline für Tabellendaten. Verbinden Sie die Eingabe (Merkmale); die Klassen kommen aus den Daten. Für seltene Klassen setzen Sie Klassengewichte auf balanced. Die Zeit zum Anpassen wächst etwa linear mit den Zeilen: für Hunderttausende Trainingszeilen und mehr."

#: catalog
msgid ""
"balanced: weight the classes inversely to their frequency (for imbalanced data, e.g. a few percent of positives)."
msgstr ""
"balanced: gewichtet die Klassen umgekehrt proportional zu ihrer Häufigkeit (für unausgewogene Daten, z. B. wenige Prozent Positive)."

#: catalog
msgid "Voting classifier"
msgstr "Voting-Klassifikator"

#: catalog
msgid ""
"Combines two or more classifiers: soft voting averages their class probabilities, hard voting counts the classes they predict. Connect the Input to every model and every model to this brick. Fitting takes as long as fitting all of them."
msgstr ""
"Kombiniert zwei oder mehr Klassifikatoren: Soft Voting mittelt ihre Klassenwahrscheinlichkeiten, Hard Voting zählt die vorhergesagten Klassen. Verbinden Sie die Eingabe mit jedem Modell und jedes Modell mit diesem Baustein. Das Anpassen dauert so lange wie das aller Modelle."

#: catalog
msgid "Voting"
msgstr "Abstimmung"

#: catalog
msgid ""
"soft: average the class probabilities of the models (usually better); hard: the class most models predict. Hard voting has no probabilities: the share of the votes stands in for them."
msgstr ""
"soft: mittelt die Klassenwahrscheinlichkeiten der Modelle (meist besser); hard: die Klasse, die die meisten Modelle vorhersagen. Hard Voting hat keine Wahrscheinlichkeiten: Der Stimmenanteil steht dafür."

#: catalog
msgid "Weights"
msgstr "Gewichte"

#: catalog
msgid ""
"One whole number per model, in the order in which the models are connected (the brick lists them), e.g. 2, 1, 1. Empty: every model counts the same."
msgstr ""
"Eine ganze Zahl pro Modell, in der Reihenfolge, in der die Modelle verbunden sind (der Baustein listet sie auf), z. B. 2, 1, 1. Leer: Jedes Modell zählt gleich."

#: catalog
msgid "Models"
msgstr "Modelle"

#: catalog
msgid "Voting regression"
msgstr "Voting-Regression"

#: catalog
msgid ""
"Averages the predictions of two or more regression models, optionally weighted. Connect the Input to every model and every model to this brick. Fitting takes as long as fitting all of them."
msgstr ""
"Mittelt die Vorhersagen von zwei oder mehr Regressionsmodellen, optional gewichtet. Verbinden Sie die Eingabe mit jedem Modell und jedes Modell mit diesem Baustein. Das Anpassen dauert so lange wie das aller Modelle."

#: catalog
msgid "Stacking classifier"
msgstr "Stacking-Klassifikator"

#: catalog
msgid ""
"Combines two or more classifiers: a logistic regression learns from their cross-validated class probabilities how much to trust each model. Connect the Input to every model and every model to this brick. Every model is fitted once per fold and once more."
msgstr ""
"Kombiniert zwei oder mehr Klassifikatoren: Eine logistische Regression lernt aus ihren kreuzvalidierten Klassenwahrscheinlichkeiten, wie sehr sie jedem Modell vertrauen kann. Verbinden Sie die Eingabe mit jedem Modell und jedes Modell mit diesem Baustein. Jedes Modell wird einmal pro Fold und einmal zusätzlich angepasst."

#: catalog
msgid "Cross-validation folds"
msgstr "Folds der Kreuzvalidierung"

#: catalog
msgid ""
"The final estimator learns from predictions that the models make for rows they were not fitted on: every model is fitted once per fold, and once more on all training rows."
msgstr ""
"Der finale Schätzer lernt aus Vorhersagen, die die Modelle für Zeilen machen, an die sie nicht angepasst wurden: Jedes Modell wird einmal pro Fold und noch einmal auf allen Trainingszeilen angepasst."

#: catalog
msgid "Pass the features through"
msgstr "Merkmale durchreichen"

#: catalog
msgid ""
"The final estimator also gets the features, not only the predictions of the models."
msgstr ""
"Der finale Schätzer bekommt auch die Merkmale, nicht nur die Vorhersagen der Modelle."

#: catalog
msgid "Stacking regression"
msgstr "Stacking-Regression"

#: catalog
msgid ""
"Combines two or more regression models: a ridge regression (RidgeCV) learns from their cross-validated predictions how to weigh them. Connect the Input to every model and every model to this brick. Every model is fitted once per fold and once more."
msgstr ""
"Kombiniert zwei oder mehr Regressionsmodelle: Eine Ridge-Regression (RidgeCV) lernt aus ihren kreuzvalidierten Vorhersagen, wie sie sie gewichtet. Verbinden Sie die Eingabe mit jedem Modell und jedes Modell mit diesem Baustein. Jedes Modell wird einmal pro Fold und einmal zusätzlich angepasst."

#: catalog
msgid ""
"A classic multi-layer perceptron for 28×28 digits flattened to 784 features."
msgstr ""
"Ein klassisches mehrschichtiges Perzeptron für 28×28-Ziffern, flach gemacht zu 784 Merkmalen."

#: catalog
msgid ""
"Two convolution blocks followed by a classifier head: about 99% test accuracy on MNIST."
msgstr ""
"Zwei Faltungsblöcke, gefolgt von einem Klassifikationskopf: etwa 99 % Testgenauigkeit auf MNIST."

#: catalog
msgid ""
"A ResNet-style block with a skip connection merged by Add, then global average pooling."
msgstr ""
"Ein Block im ResNet-Stil mit einer Skip-Verbindung, die Add zusammenführt, dann Global Average Pooling."

#: catalog
msgid ""
"An encoder that halves the image three times, a decoder that upsamples it again with ConvTranspose2d, and skip connections (Concat) that pass the details across. The output is one score per class for every pixel: it trains on the built-in Shapes dataset (background, square, circle, triangle) as it is, on Cells (background, cell, nucleus) with 3 output channels in the last layer, or on your own images with masks."
msgstr ""
"Ein Encoder, der das Bild dreimal halbiert, ein Decoder, der es mit ConvTranspose2d wieder vergrößert, und Skip-Verbindungen (Concat), die die Details hinüberreichen. Die Ausgabe ist ein Score pro Klasse für jedes Pixel: Es trainiert unverändert auf dem eingebauten Datensatz Shapes (Hintergrund, Quadrat, Kreis, Dreieck), mit 3 Ausgabekanälen in der letzten Schicht auf Cells (Hintergrund, Zelle, Zellkern) oder auf Ihren eigenen Bildern mit Masken."

#: catalog
msgid ""
"Classification with a U-Net: the encoder, decoder and skip connections of the U-Net example, then AdaptiveAvgPool2d, Flatten and Linear give 10 class scores. Fashion-MNIST's 28×28 images are resized to 32×32 so that three halvings fit (32 → 16 → 8 → 4), and the filters are halved (16/32/64, bottleneck 128) so that it trains on a CPU server. For this task a plain CNN such as the Small CNN example is smaller and faster; this one shows how a segmentation network becomes a classifier."
msgstr ""
"Klassifikation mit einem U-Net: Encoder, Decoder und Skip-Verbindungen des U-Net-Beispiels, danach ergeben AdaptiveAvgPool2d, Flatten und Linear 10 Klassen-Scores. Die 28×28-Bilder von Fashion-MNIST werden auf 32×32 vergrößert, damit drei Halbierungen passen (32 → 16 → 8 → 4), und die Filter sind halbiert (16/32/64, Engpass 128), damit es auf einem CPU-Server trainiert. Für diese Aufgabe ist ein einfaches CNN wie das Beispiel Small CNN kleiner und schneller; dieses zeigt, wie aus einem Segmentierungsnetz ein Klassifikator wird."

#: catalog
msgid ""
"Token ids → embeddings → bidirectional LSTM → positive/negative sentiment. It trains on the built-in text dataset Sentiment once the check of the training has set its Input to 24 tokens and its Embedding to 151 words."
msgstr ""
"Token-IDs → Embeddings → bidirektionales LSTM → positive/negative Stimmung. Es trainiert auf dem eingebauten Textdatensatz Sentiment, sobald die Prüfung des Trainings seine Eingabe auf 24 Tokens und sein Embedding auf 151 Wörter gesetzt hat."

#: catalog
msgid ""
"A small Transformer encoder with learned positional embeddings and mean pooling. It trains on the built-in text dataset Topics as it is; the check of the training adapts it to Sentiment and Key lookup (sequence length, vocabulary, classes)."
msgstr ""
"Ein kleiner Transformer-Encoder mit gelernten Positions-Embeddings und Mean Pooling. Er trainiert unverändert auf dem eingebauten Textdatensatz Topics; die Prüfung des Trainings passt ihn an Sentiment und Key lookup an (Sequenzlänge, Vokabular, Klassen)."

#: catalog
msgid ""
"Predicts one number from 8 numeric features. The generated script can train on a CSV file."
msgstr ""
"Sagt eine Zahl aus 8 numerischen Merkmalen vorher. Das erzeugte Skript kann auf einer CSV-Datei trainieren."

#: catalog
msgid ""
"Combines an image and a vector of metadata with Concat, e.g. for price prediction from a photo and attributes."
msgstr ""
"Kombiniert ein Bild und einen Vektor mit Metadaten über Concat, z. B. für eine Preisvorhersage aus einem Foto und Attributen."

#: catalog
msgid ""
"A classical model (scikit-learn): predicts one number from 8 features with its uncertainty. The kernel is a scaled RBF plus white noise, whose hyperparameters are fitted to the data. Train it on a small CSV file (up to a few thousand rows)."
msgstr ""
"Ein klassisches Modell (scikit-learn): sagt eine Zahl aus 8 Merkmalen mit ihrer Unsicherheit vorher. Der Kernel ist ein skalierter RBF plus weißes Rauschen, dessen Hyperparameter an die Daten angepasst werden. Trainieren Sie es auf einer kleinen CSV-Datei (bis zu einigen Tausend Zeilen)."

#: catalog
msgid ""
"A classical model (scikit-learn): a support vector machine with an RBF kernel classifies rows of 4 numeric features (e.g. the iris flowers) and gives class probabilities. The classes come from the target column of the data."
msgstr ""
"Ein klassisches Modell (scikit-learn): Eine Support Vector Machine mit RBF-Kernel klassifiziert Zeilen mit 4 numerischen Merkmalen (z. B. die Iris-Blüten) und gibt Klassenwahrscheinlichkeiten aus. Die Klassen kommen aus der Zielspalte der Daten."

#: catalog
msgid ""
"A classical model (scikit-learn) for seasonal data, e.g. a value over time: a slowly changing periodic pattern (RBF × ExpSineSquared) plus a smooth trend (RBF) and noise. Set the periodicity to the season length in standardised units of the time feature."
msgstr ""
"Ein klassisches Modell (scikit-learn) für saisonale Daten, z. B. einen Wert über die Zeit: ein sich langsam änderndes periodisches Muster (RBF × ExpSineSquared) plus ein glatter Trend (RBF) und Rauschen. Setzen Sie die Periodizität auf die Saisonlänge in standardisierten Einheiten des Zeitmerkmals."

#: catalog
msgid ""
"A classical model (scikit-learn): gradient-boosted decision trees classify rows of 30 numeric features and give class probabilities. A strong baseline for large tables; balanced class weights help with rare classes (e.g. a few percent of fraud cases). The classes come from the target column of the data."
msgstr ""
"Ein klassisches Modell (scikit-learn): Gradient-geboostete Entscheidungsbäume klassifizieren Zeilen mit 30 numerischen Merkmalen und geben Klassenwahrscheinlichkeiten aus. Eine starke Baseline für große Tabellen; ausgeglichene Klassengewichte helfen bei seltenen Klassen (z. B. wenigen Prozent Betrugsfällen). Die Klassen kommen aus der Zielspalte der Daten."

#: catalog
msgid ""
"An ensemble of classical models (scikit-learn): gradient boosting, a support vector machine and a Gaussian process classify rows of 4 numeric features (e.g. the iris flowers), and soft voting averages their class probabilities. Every model takes the features from the Input; the dotted connections into the voting brick carry the models themselves. The classes come from the target column of the data."
msgstr ""
"Ein Ensemble klassischer Modelle (scikit-learn): Gradient Boosting, eine Support Vector Machine und ein Gauß-Prozess klassifizieren Zeilen mit 4 numerischen Merkmalen (z. B. die Iris-Blüten), und Soft Voting mittelt ihre Klassenwahrscheinlichkeiten. Jedes Modell bekommt die Merkmale von der Eingabe; die gepunkteten Verbindungen in den Voting-Baustein tragen die Modelle selbst. Die Klassen kommen aus der Zielspalte der Daten."

#: catalog
msgid ""
"An ensemble of classical models (scikit-learn) that predicts a number from 8 numeric features (e.g. house prices): gradient boosting, a support vector machine and a Gaussian process with an RBF + noise kernel, combined by stacking. A ridge regression learns from their predictions for rows they were not fitted on (5-fold cross-validation) how to weigh them. The dotted connections into the stacking brick carry the models themselves."
msgstr ""
"Ein Ensemble klassischer Modelle (scikit-learn), das eine Zahl aus 8 numerischen Merkmalen vorhersagt (z. B. Hauspreise): Gradient Boosting, eine Support Vector Machine und ein Gauß-Prozess mit RBF- plus Rausch-Kernel, kombiniert durch Stacking. Eine Ridge-Regression lernt aus ihren Vorhersagen für Zeilen, an die sie nicht angepasst wurden (5-fache Kreuzvalidierung), wie sie sie gewichtet. Die gepunkteten Verbindungen in den Stacking-Baustein tragen die Modelle selbst."

#: catalog
msgid ""
"A hybrid network for tables of 8 numeric features: an MLP learns 32 features (first with a temporary linear head on the target), then gradient-boosted trees are fitted on them and predict the class. Set the Input to the number of feature columns of your data."
msgstr ""
"Ein hybrides Netz für Tabellen mit 8 numerischen Merkmalen: Ein MLP lernt 32 Merkmale (zuerst mit einem temporären linearen Kopf auf der Zielspalte), dann werden gradient-geboostete Bäume darauf angepasst und sagen die Klasse vorher. Setzen Sie die Eingabe auf die Anzahl der Merkmalsspalten Ihrer Daten."

#: catalog
msgid "Combine data"
msgstr "Daten kombinieren"

#: catalog
msgid "Columns"
msgstr "Spalten"

#: catalog
msgid "Rows"
msgstr "Zeilen"

#: catalog
msgid "Missing values"
msgstr "Fehlende Werte"

#: catalog
msgid "Outliers & clipping"
msgstr "Ausreißer & Begrenzen"

#: catalog
msgid "Transform numbers"
msgstr "Zahlen transformieren"

#: catalog
msgid "Feature engineering"
msgstr "Feature Engineering"

#: catalog
msgid "Encode categories"
msgstr "Kategorien kodieren"

#: catalog
msgid "Dates & times"
msgstr "Datum & Uhrzeit"

#: catalog
msgid "Target & balance"
msgstr "Zielspalte & Ausgleich"

#: catalog
msgid "Feature selection"
msgstr "Merkmalsauswahl"

#: catalog
msgid "Join another table"
msgstr "Andere Tabelle verknüpfen (Join)"

#: catalog
msgid "Add the columns of another imported table by matching key columns."
msgstr ""
"Fügt die Spalten einer anderen importierten Tabelle über passende Schlüsselspalten hinzu."

#: catalog
msgid "Table"
msgstr "Tabelle"

#: catalog
msgid "Keep"
msgstr "Behalten"

#: catalog
msgid "Which rows to keep when a key has no match."
msgstr ""
"Welche Zeilen behalten werden, wenn ein Schlüssel keine Entsprechung hat."

#: catalog
msgid "All rows of this table (left join)"
msgstr "Alle Zeilen dieser Tabelle (Left Join)"

#: catalog
msgid "Only matching rows (inner join)"
msgstr "Nur passende Zeilen (Inner Join)"

#: catalog
msgid "All rows of both tables (outer join)"
msgstr "Alle Zeilen beider Tabellen (Outer Join)"

#: catalog
msgid "All rows of the other table (right join)"
msgstr "Alle Zeilen der anderen Tabelle (Right Join)"

#: catalog
msgid "Key columns here"
msgstr "Schlüsselspalten hier"

#: catalog
msgid "Key columns there"
msgstr "Schlüsselspalten dort"

#: catalog
msgid "Same number and order as the key columns here."
msgstr "Gleiche Anzahl und Reihenfolge wie die Schlüsselspalten hier."

#: catalog
msgid "The same names as here"
msgstr "Dieselben Namen wie hier"

#: catalog
msgid "Suffix for duplicate names"
msgstr "Suffix für doppelte Namen"

#: catalog
msgid "Added to columns of the other table whose names exist here already."
msgstr ""
"Wird an Spalten der anderen Tabelle angehängt, deren Namen es hier schon gibt."

#: catalog
msgid "Append rows"
msgstr "Zeilen anhängen"

#: catalog
msgid "Add the rows of another imported table with the same columns below."
msgstr ""
"Hängt die Zeilen einer anderen importierten Tabelle mit denselben Spalten unten an."

#: catalog
msgid "Add a column with the table name"
msgstr "Spalte mit dem Tabellennamen hinzufügen"

#: catalog
msgid "Marks every row with the name of the table it comes from."
msgstr "Markiert jede Zeile mit dem Namen der Tabelle, aus der sie stammt."

#: catalog
msgid "Column name"
msgstr "Spaltenname"

#: catalog
msgid "Drop columns"
msgstr "Spalten entfernen"

#: catalog
msgid "Remove columns that should not be used, e.g. IDs or free text."
msgstr ""
"Entfernt Spalten, die nicht verwendet werden sollen, z. B. IDs oder Freitext."

#: catalog
msgid "Keep only some columns"
msgstr "Nur einige Spalten behalten"

#: catalog
msgid "Keep the chosen columns (and the target) and drop all others."
msgstr ""
"Behält die gewählten Spalten (und die Zielspalte) und entfernt alle anderen."

#: catalog
msgid "Columns to keep"
msgstr "Zu behaltende Spalten"

#: catalog
msgid "The target column is always kept."
msgstr "Die Zielspalte wird immer behalten."

#: catalog
msgid "Rename columns"
msgstr "Spalten umbenennen"

#: catalog
msgid "Give columns new names."
msgstr "Gibt Spalten neue Namen."

#: catalog
msgid "New names"
msgstr "Neue Namen"

#: catalog
msgid "Current name → new name."
msgstr "Aktueller Name → neuer Name."

#: catalog
msgid "Change type"
msgstr "Typ ändern"

#: catalog
msgid "Change the type of columns, e.g. read text as numbers or dates."
msgstr ""
"Ändert den Typ von Spalten, z. B. um Text als Zahlen oder Datumswerte zu lesen."

#: catalog
msgid "New type"
msgstr "Neuer Typ"

#: catalog
msgid ""
"Values that cannot be converted become missing; the step says how many. Dates become seconds since 1970 as numbers, and vice versa."
msgstr ""
"Werte, die sich nicht umwandeln lassen, werden zu fehlenden Werten; der Schritt sagt, wie viele. Datumswerte werden zu Sekunden seit 1970 als Zahlen und umgekehrt."

#: catalog
msgid "Numbers"
msgstr "Zahlen"

#: catalog
msgid "Categories"
msgstr "Kategorien"

#: catalog
msgid "True/false"
msgstr "Wahr/falsch"

#: catalog
msgid "Dates"
msgstr "Datumswerte"

#: catalog
msgid "Free text"
msgstr "Freitext"

#: catalog
msgid "Decimal comma (1.234,5)"
msgstr "Dezimalkomma (1.234,5)"

#: catalog
msgid "Ignore units and thousands separators"
msgstr "Einheiten und Tausendertrennzeichen ignorieren"

#: catalog
msgid ""
"Reads the number in values like '$1,200', '12 kg' or '45 %' (1200, 12 and 45): text before and after the number and thousands separators are ignored."
msgstr ""
"Liest die Zahl in Werten wie '$1,200', '12 kg' oder '45 %' (1200, 12 und 45): Text vor und nach der Zahl sowie Tausendertrennzeichen werden ignoriert."

#: catalog
msgid "Date format"
msgstr "Datumsformat"

#: catalog
msgid "e.g. %d.%m.%Y for 31.01.2024. Empty: detect the format."
msgstr "z. B. %d.%m.%Y für 31.01.2024. Leer: Format erkennen."

#: catalog
msgid "Formula"
msgstr "Formel"

#: catalog
msgid ""
"Compute a new column from other columns, e.g. weight / height ** 2, or from text, e.g. the deck of a cabin: map(upper(left(`Cabin`, 1)), {\"A\": 1, …})."
msgstr ""
"Berechnet eine neue Spalte aus anderen Spalten, z. B. weight / height ** 2, oder aus Text, z. B. das Deck einer Kabine: map(upper(left(`Cabin`, 1)), {\"A\": 1, …})."

#: catalog
msgid "New column"
msgstr "Neue Spalte"

#: catalog
msgid "An existing column is replaced."
msgstr "Eine vorhandene Spalte wird ersetzt."

#: catalog
msgid ""
"Columns by name (`my column` in backticks), numbers, text in quotes, + - * / // % **, comparisons (give 1/0; text with == and !=), and, or, not, and log, log1p, exp, sqrt, abs, round, floor, ceil, min(a, b), max(a, b), clip(x, lo, hi), where(cond, a, b), isnull(x). Text: left(x, n), right(x, n), mid(x, start, length), upper, lower, strip, len, contains(x, \"text\") (also startswith, endswith; ignore_case=1), replace(x, \"old\", \"new\"), extract(x, \"pattern\"), split_part(x, \" \", k), concat(a, b, …), to_number, to_text, map(x, {\"A\": 1, …}, default), coalesce(a, b, …). A missing input gives a missing result."
msgstr ""
"Spalten über ihren Namen (`meine Spalte` in Backticks), Zahlen, Text in Anführungszeichen, + - * / // % **, Vergleiche (ergeben 1/0; Text mit == und !=), and, or, not sowie log, log1p, exp, sqrt, abs, round, floor, ceil, min(a, b), max(a, b), clip(x, lo, hi), where(cond, a, b), isnull(x). Text: left(x, n), right(x, n), mid(x, start, length), upper, lower, strip, len, contains(x, \"text\") (auch startswith, endswith; ignore_case=1), replace(x, \"old\", \"new\"), extract(x, \"pattern\"), split_part(x, \" \", k), concat(a, b, …), to_number, to_text, map(x, {\"A\": 1, …}, default), coalesce(a, b, …). Eine fehlende Eingabe ergibt ein fehlendes Ergebnis."

#: catalog
msgid "Replace values"
msgstr "Werte ersetzen"

#: catalog
msgid "Replace values with others, e.g. fix spellings or merge categories."
msgstr ""
"Ersetzt Werte durch andere, z. B. um Schreibweisen zu korrigieren oder Kategorien zusammenzufassen."

#: catalog
msgid "Replacements"
msgstr "Ersetzungen"

#: catalog
msgid ""
"Old value → new value; leave the new value empty to mark it as missing. Numbers are compared as numbers in numeric columns."
msgstr ""
"Alter Wert → neuer Wert; lassen Sie den neuen Wert leer, um ihn als fehlend zu markieren. In Zahlenspalten werden Zahlen als Zahlen verglichen."

#: catalog
msgid "Extract from text"
msgstr "Aus Text extrahieren"

#: catalog
msgid ""
"Take a part of a text column into a new column, e.g. the deck letter of a cabin (C85 → C), and optionally map it to numbers (A → 1, B → 2 …)."
msgstr ""
"Übernimmt einen Teil einer Textspalte in eine neue Spalte, z. B. den Deck-Buchstaben einer Kabine (C85 → C), und bildet ihn optional auf Zahlen ab (A → 1, B → 2 …)."

#: catalog
msgid "Text column"
msgstr "Textspalte"

#: catalog
msgid "Take"
msgstr "Übernehmen"

#: catalog
msgid "Values without such a part (too few words, no match) become missing."
msgstr ""
"Werte ohne einen solchen Teil (zu wenige Wörter, kein Treffer) werden zu fehlenden Werten."

#: catalog
msgid "The first characters"
msgstr "Die ersten Zeichen"

#: catalog
msgid "The last characters"
msgstr "Die letzten Zeichen"

#: catalog
msgid "The match of a pattern (regular expression)"
msgstr "Den Treffer eines Musters (regulärer Ausdruck)"

#: catalog
msgid "A word"
msgstr "Ein Wort"

#: catalog
msgid "Characters"
msgstr "Zeichen"

#: catalog
msgid "How many characters to take."
msgstr "Wie viele Zeichen übernommen werden."

#: catalog
msgid "Pattern"
msgstr "Muster"

#: catalog
msgid ""
"A regular expression (Python), e.g. [A-Z] for the first capital letter or \\d+ for the first number. With a group in brackets the first group is taken, else the whole match. At most 200 characters."
msgstr ""
"Ein regulärer Ausdruck (Python), z. B. [A-Z] für den ersten Großbuchstaben oder \\d+ für die erste Zahl. Mit einer Gruppe in Klammern wird die erste Gruppe übernommen, sonst der ganze Treffer. Höchstens 200 Zeichen."

#: catalog
msgid "Word number"
msgstr "Wortnummer"

#: catalog
msgid ""
"1 is the first word, 2 the second; -1 is the last word. Words are split by spaces."
msgstr ""
"1 ist das erste Wort, 2 das zweite; -1 ist das letzte Wort. Wörter werden an Leerzeichen getrennt."

#: catalog
msgid "Trim spaces first"
msgstr "Zuerst Leerzeichen entfernen"

#: catalog
msgid ""
"Remove spaces at the start and the end of every value before taking the part."
msgstr ""
"Entfernt Leerzeichen am Anfang und Ende jedes Werts, bevor der Teil übernommen wird."

#: catalog
msgid "Case"
msgstr "Groß-/Kleinschreibung"

#: catalog
msgid "Of the part taken, before the mapping."
msgstr "Des übernommenen Teils, vor der Abbildung."

#: catalog
msgid "Keep as it is"
msgstr "Unverändert lassen"

#: catalog
msgid "UPPER CASE"
msgstr "GROSSBUCHSTABEN"

#: catalog
msgid "lower case"
msgstr "kleinbuchstaben"

#: catalog
msgid "Map to new values"
msgstr "Auf neue Werte abbilden"

#: catalog
msgid ""
"Optional: part → new value, e.g. A → 1, B → 2. If every new value is a number, the new column holds numbers. Parts not listed become missing. Empty: the parts themselves, as categories."
msgstr ""
"Optional: Teil → neuer Wert, z. B. A → 1, B → 2. Sind alle neuen Werte Zahlen, enthält die neue Spalte Zahlen. Nicht aufgeführte Teile werden zu fehlenden Werten. Leer: die Teile selbst, als Kategorien."

#: catalog
msgid "Remove atypical rows"
msgstr "Untypische Zeilen entfernen"

#: catalog
msgid ""
"Remove rows whose values are all unusually close to the column medians (filler or synthetic rows), or unusually far from them. Runs before the split, on all rows."
msgstr ""
"Entfernt Zeilen, deren Werte alle ungewöhnlich nah an den Medianen der Spalten liegen (Füll- oder synthetische Zeilen) oder ungewöhnlich weit davon entfernt. Läuft vor der Aufteilung, auf allen Zeilen."

#: catalog
msgid "Measure on"
msgstr "Messen anhand"

#: catalog
msgid ""
"Distances and spreads use these number columns (never the target or ID columns). In wide tables most columns without any correlated partner are noise, and noise columns drown the differences between rows; Automatic uses the columns with a strong partner (largest |Spearman r| ≥ 0.3) in tables with more than 20 number columns."
msgstr ""
"Abstände und Streuungen verwenden diese Zahlenspalten (nie die Zielspalte oder ID-Spalten). In breiten Tabellen sind die meisten Spalten ohne korrelierten Partner Rauschen, und Rauschspalten überdecken die Unterschiede zwischen Zeilen; Automatisch verwendet in Tabellen mit mehr als 20 Zahlenspalten die Spalten mit einem starken Partner (größtes |Spearman-r| ≥ 0,3)."

#: catalog
msgid "Automatic (partnered columns in wide tables)"
msgstr "Automatisch (Spalten mit Partner in breiten Tabellen)"

#: catalog
msgid "Columns with a strong partner"
msgstr "Spalten mit einem starken Partner"

#: catalog
msgid "All number columns"
msgstr "Alle Zahlenspalten"

#: catalog
msgid "Columns I choose"
msgstr "Von mir gewählte Spalten"

#: catalog
msgid "Remove rows that are"
msgstr "Zeilen entfernen, die"

#: catalog
msgid ""
"The spread of a row is the median of |robust z| over its values; ordinary rows have about 0.67. Too typical rows (near 0) are often filler or synthetic rows with made-up labels."
msgstr ""
"Die Streuung einer Zeile ist der Median von |robustem z| über ihre Werte; gewöhnliche Zeilen haben etwa 0,67. Zu typische Zeilen (nahe 0) sind oft Füll- oder synthetische Zeilen mit erfundenen Labels."

#: catalog
msgid "Too typical: every value close to its median"
msgstr "Zu typisch sind: jeder Wert nah an seinem Median"

#: catalog
msgid "Unusual: values far from the medians"
msgstr "Ungewöhnlich sind: Werte weit von den Medianen"

#: catalog
msgid "Spread threshold"
msgstr "Schwellenwert der Streuung"

#: catalog
msgid ""
"Rows with a spread below (too typical) or above (unusual) this value are removed. Empty: the gap the Rows analysis finds between a small cluster and the other rows (nothing is removed if there is no clear gap)."
msgstr ""
"Zeilen mit einer Streuung unter (zu typisch) oder über (ungewöhnlich) diesem Wert werden entfernt. Leer: die Lücke, die die Zeilenanalyse zwischen einem kleinen Cluster und den übrigen Zeilen findet (ohne klare Lücke wird nichts entfernt)."

#: catalog
msgid "Find near-duplicate groups"
msgstr "Gruppen fast gleicher Zeilen finden"

#: catalog
msgid ""
"Add a column that numbers groups of rows that are near twins of each other (e.g. repeated measurements of one person). Keep the groups together in the split (Target & split). Runs before the split, on all rows."
msgstr ""
"Fügt eine Spalte hinzu, die Gruppen von Zeilen nummeriert, die einander fast gleichen (z. B. wiederholte Messungen einer Person). Halten Sie die Gruppen bei der Aufteilung zusammen (Zielspalte & Aufteilung). Läuft vor der Aufteilung, auf allen Zeilen."

#: catalog
msgid "Compare rows on"
msgstr "Zeilen vergleichen anhand"

#: catalog
msgid "NN ratio threshold"
msgstr "Schwellenwert des NN-Verhältnisses"

#: catalog
msgid ""
"Two rows are near twins if one is among the 10 nearest rows of the other and their distance is below this share of the typical distance between two rows. Empty: the valley the Rows analysis finds between rows with a near twin and the others (no groups if there is none)."
msgstr ""
"Zwei Zeilen sind fast gleich, wenn eine unter den 10 nächsten Zeilen der anderen ist und ihr Abstand unter diesem Anteil des typischen Abstands zweier Zeilen liegt. Leer: das Tal, das die Zeilenanalyse zwischen Zeilen mit fast gleichem Zwilling und den übrigen findet (ohne Tal keine Gruppen)."

#: catalog
msgid "Name of the new column"
msgstr "Name der neuen Spalte"

#: catalog
msgid "Drop rows"
msgstr "Zeilen entfernen"

#: catalog
msgid ""
"Remove rows picked by hand, e.g. in Analysis → Rows: by the values of an ID column, or by their row numbers."
msgstr ""
"Entfernt von Hand gewählte Zeilen, z. B. in Analyse → Zeilen: über die Werte einer ID-Spalte oder über ihre Zeilennummern."

#: catalog
msgid "Pick rows by"
msgstr "Zeilen wählen über"

#: catalog
msgid ""
"Values of an ID column stay right when earlier steps change. Row numbers (0 = first row) count the rows as they are right before this step."
msgstr ""
"Werte einer ID-Spalte bleiben richtig, wenn sich frühere Schritte ändern. Zeilennummern (0 = erste Zeile) zählen die Zeilen so, wie sie direkt vor diesem Schritt sind."

#: catalog
msgid "Values of a column (e.g. an id)"
msgstr "Werte einer Spalte (z. B. einer ID)"

#: catalog
msgid "Row numbers"
msgstr "Zeilennummern"

#: catalog
msgid "Column"
msgstr "Spalte"

#: catalog
msgid "Values"
msgstr "Werte"

#: catalog
msgid "Remove duplicates"
msgstr "Duplikate entfernen"

#: catalog
msgid "Remove rows that repeat another row (in all or in some columns)."
msgstr ""
"Entfernt Zeilen, die eine andere Zeile wiederholen (in allen oder in einigen Spalten)."

#: catalog
msgid "Compare"
msgstr "Vergleichen"

#: catalog
msgid "Rows count as duplicates if they agree in these columns."
msgstr ""
"Zeilen gelten als Duplikate, wenn sie in diesen Spalten übereinstimmen."

#: catalog
msgid "All columns"
msgstr "Alle Spalten"

#: catalog
