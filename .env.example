# Copy to .env and adjust. Docker Compose reads this file automatically.

# Leave empty to generate a secret key on first start (stored in the data volume).
DJANGO_SECRET_KEY=

# Host names the server answers to, and the origins allowed for the Django admin.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Set to false to disable public sign-up (e.g. for a private instance).
BRICKDNN_ALLOW_REGISTRATION=true

# Port of the web UI on the host.
BRICKDNN_PORT=8080

# --- Training --------------------------------------------------------------
# Install PyTorch (CPU, about 1 GB) into the backend image. Needed for training.
# Rebuild after changing it: docker compose up -d --build
BRICKDNN_INSTALL_TORCH=false

# Set to false to disable training completely.
BRICKDNN_TRAINING=true

# Trainings wait in a queue in the database and the worker service trains them (plans with a
# higher priority first, see docs/training.md, "The training queue"). false: no queue, the
# backend trains itself and refuses a start while it is busy (the worker service then idles).
# BRICKDNN_TRAINING_WORKER=true
# Trainings the worker runs at the same time (unset: BRICKDNN_TRAINING_MAX_RUNS).
# BRICKDNN_WORKER_SLOTS=1
# Trainings of one account that may wait in the queue (unset: 3 with plans, else no limit;
# a plan can set its own with "queued_trainings").
# BRICKDNN_QUEUE_MAX_WAITING=3

# Trainings that may run at the same time (counted across all users).
BRICKDNN_TRAINING_MAX_RUNS=1

# Maximum size of an uploaded dataset (CSV or ZIP) in MB.
BRICKDNN_MAX_UPLOAD_MB=500

# Usernames (comma-separated) of accounts that are administrators: when the backend starts they
# become staff and superusers (Django admin, no limits), and nobody can register these names.
# Create the account first. Removing a name takes no rights away (use the Django admin).
# BRICKDNN_ADMIN_USERS=

# --- Privacy (docs/privacy.md) -------------------------------------------------
# Imprint, privacy policy and terms of use are the files imprint.md, privacy.md and terms.md
# (templates in deploy/legal/) in BRICKDNN_LEGAL_DIR: by default `legal` in the data directory,
# /data/legal in Docker. With terms.md, sign-up asks to accept the terms.

# Delete data sources, datasets and finished trainings nobody has used for this many days,
# and accounts nobody has logged in to for this many days (with everything they own).
# Unset or 0 keeps everything (on a server of deploy/server, unset uses the periods in
# deploy/sites/<domain>/settings.env, if any). The cleanup service runs once a day.
# BRICKDNN_DELETE_UNUSED_UPLOADS_DAYS=0
# BRICKDNN_DELETE_INACTIVE_ACCOUNTS_DAYS=0

# What AI assistants and scripts do with users' API tokens and connected apps is logged for
# them (page "Agent activity") and kept this many days; 0 switches the log off.
# BRICKDNN_AGENT_LOG_DAYS=90
# --- Budgets (docs/training.md, "Usage and budgets") -----------------------------
# Plans with their limits per account (compute per month in CPU hours, storage, compute per
# training, trainings at a time, and the priority in the training queue: higher starts first)
# as JSON on one line, and the plan of new accounts. Unset: no limits. Accounts are changed
# with `manage.py set_plan` or in the Django admin.
# BRICKDNN_PLANS={"free": {"name": "Free", "price": 0, "cpu_hours_per_month": 0.5, "storage_gb": 1, "cpu_minutes_per_run": 15, "concurrent_trainings": 1, "priority": 0}}
# BRICKDNN_DEFAULT_PLAN=free
# Without plans, the same for every account (0 or unset: unlimited):
# BRICKDNN_BUDGET_CPU_MINUTES_PER_MONTH=0
# BRICKDNN_BUDGET_CPU_MINUTES_PER_RUN=0
# BRICKDNN_BUDGET_STORAGE_MB=0
# Show usage in money (display only):
# BRICKDNN_PRICE_PER_CPU_HOUR=
# BRICKDNN_PRICE_CURRENCY=EUR

# --- Paid plans with Paddle (docs/billing.md) -----------------------------------
# Off unless all of these are set (and BRICKDNN_PLANS defines the plans): then accounts can buy
# a plan, and a paid subscription sets the plan of the account. `python manage.py billing_sync
# --check` says whether the settings fit together and what Paddle thinks of them.
# sandbox (Paddle's test system, test cards only) or live.
# BRICKDNN_PADDLE_ENV=sandbox
# The client-side token for Paddle.js (public: the browser gets it).
# BRICKDNN_PADDLE_CLIENT_TOKEN=test_...
# The Paddle price of each paid plan (monthly, in BRICKDNN_PRICE_CURRENCY, tax included).
# BRICKDNN_PADDLE_PRICES=starter=pri_...,plus=pri_...,pro=pri_...
# The Paddle product that compute beyond the allowance is billed as (empty: no overage).
# BRICKDNN_PADDLE_OVERAGE_PRODUCT=pro_...
# SECRET: the API key, and the secret of the notification destination that points to
# https://<your domain>/api/billing/paddle/webhook/. Only ever here, never in the repository.
# BRICKDNN_PADDLE_API_KEY=
# BRICKDNN_PADDLE_WEBHOOK_SECRET=
# After a failed payment the account keeps its plan this many days while Paddle retries.
# BRICKDNN_PADDLE_GRACE_DAYS=7

# --- Monitoring (deploy/server/README.md, "Monitoring") --------------------------
# /api/health/ reports "degraded" when the data directory has less than this many MB free
# (0: no check).
# BRICKDNN_HEALTH_MIN_FREE_MB=1024
# SECRET: requests with the header X-Health-Token: <this> see the details of /api/health/
# (free space, worker heartbeat, error messages); without it only staff accounts do.
# BRICKDNN_HEALTH_TOKEN=
