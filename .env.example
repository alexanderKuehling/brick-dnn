# Copy to .env and adjust. Every value is optional.

# Port on which Docker Compose serves the app.
BRICKDNN_PORT=8080

# Long random string. If empty, one is generated and stored in the data volume.
DJANGO_SECRET_KEY=

# Host names the server answers to (comma separated) and the matching origins.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Set to false to disable public sign-up on your instance.
BRICKDNN_ALLOW_REGISTRATION=true
